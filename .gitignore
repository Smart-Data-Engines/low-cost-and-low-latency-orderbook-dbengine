# ── Build directories ──────────────────────────────────────────────────────────
build/
build_*/
build-*/
cmake-build-*/
out/

# ── CMake generated files ─────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
CMakeUserPresets.json

# ── Coverage artifacts ────────────────────────────────────────────────────────
*.gcda
*.gcno
*.gcov
coverage.info
coverage_filtered.info
coverage_html/
coverage.profdata
*.profraw

# ── Benchmark output ──────────────────────────────────────────────────────────
results.json

# ── Test run artifacts ────────────────────────────────────────────────────────
# ReplicationClientConfig::state_file defaults to the relative path
# "repl_state.txt", so any test that does not override it writes into the
# current working directory.
/repl_state.txt

# ── Compiled objects / binaries ───────────────────────────────────────────────
*.o
*.a
*.so
*.dylib
*.exe
# Only root-level binaries from in-source builds. Do NOT use a bare `test_*`
# pattern here: it silently swallows tests/integration/test_*.py sources.
/bench_engine
/test_*

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
.hypothesis/
.pytest_cache/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
_skbuild/
.eggs/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/
.ccls-cache/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
