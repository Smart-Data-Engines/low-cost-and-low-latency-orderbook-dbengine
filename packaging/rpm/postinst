#!/bin/sh
# Have systemd read the unit just installed. Deliberately not enabled or started, as with the .deb: a
# database that begins serving on a port the moment it is unpacked is a surprise, and the default
# configuration is a single node an operator has not yet pointed at anything.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
echo "orderbook-dbengine installed. Review /etc/orderbook/ob.conf, then:"
echo "  systemctl enable --now ob_tcp_server"
