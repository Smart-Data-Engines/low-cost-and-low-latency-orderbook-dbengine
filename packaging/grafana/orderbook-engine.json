      "type": "timeseries",
      "title": "Age of the last complete backup",
      "id": 33,
      "description": "Seconds since the cut of the last complete backup in --backup-dir; read from the directory at start, so a restart does not reset it. No line: this node has never completed one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 78
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (instance) (ob_backup_last_success_timestamp_seconds{job=~\"$job\", instance=~\"$instance\"} > 0)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
