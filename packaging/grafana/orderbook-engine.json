      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_repl_records_replayed{job=~\"$job\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "applied/s {{instance}}",
          "datasource": {
