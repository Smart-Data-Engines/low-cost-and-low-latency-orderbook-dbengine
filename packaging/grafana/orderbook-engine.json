{
  "title": "Orderbook DB Engine",
  "uid": "orderbook-engine",
  "description": "What an orderbook-dbengine node exports on --metrics-port: writes, durability, storage, replication and failover, the multi-master mesh. Every metric here is checked against the engine's registry by scripts/check_dashboards.py.",
  "tags": [
    "orderbook-dbengine"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ob_build_info, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ob_build_info{job=~\"$job\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Writes and queries",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Inserts a second",
      "id": 2,
      "description": "Writes taken, from ob_total_inserts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_total_inserts{job=~\"$job\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Insert latency",
      "id": 3,
      "description": "A batch's latency is the batch's: the answers of one read go out together.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(ob_insert_latency_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(ob_insert_latency_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queries a second and their p99",
      "id": 4,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_total_queries{job=~\"$job\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "queries/s {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(ob_query_latency_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 s {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Client sessions",
      "id": 5,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_active_sessions{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refused commands and failed authentications",
      "id": 6,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_refused_commands_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "refused {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(ob_auth_failures_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "auth failures {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Subscriptions",
      "id": 7,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_subscriptions_active{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "active {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(ob_subscription_overflow_disconnects_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "overflow disconnects/s {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Flush and durability",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Flush tick latency",
      "id": 9,
      "description": "At the write ceiling the tick is what bounds a writer: past about half a second the pending queue fills.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(ob_flush_latency_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending and unsealed rows",
      "id": 10,
      "description": "Pending rows wait for the flush tick (1 000 000 is the ceiling where writers wait); unsealed rows are in blocks, readable, not yet in segments (budget 4 000 000).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_pending_rows{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "pending {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "ob_unsealed_rows{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "unsealed {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Writers waiting for room, and refused",
      "id": 11,
      "description": "A refusal is a write the pending queue never freed room for in 5 s: the flush cannot keep up with the device, or cannot make progress at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_writer_backpressure_waits_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "waits/s {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(ob_writer_backpressure_refusals_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "refusals/s {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sync and flush errors",
      "id": 12,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(ob_wal_fsync_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "WAL fsync {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(ob_segment_sync_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "segment sync {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (increase(ob_flush_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "flush {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Checkpoints frozen",
      "id": 13,
      "description": "1 after a failed sync: no checkpoint claims anything and WAL retention stops until a restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_checkpoints_frozen{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Background loop errors",
      "id": 14,
      "description": "An iteration of a background loop that threw and was abandoned; the loop goes on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (increase(ob_loop_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (increase(ob_monitor_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "monitor {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Storage",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Segments",
      "id": 16,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_segment_count{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "indexed {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "ob_segments_awaiting_removal{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "awaiting removal {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Seals and merges a second",
      "id": 17,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(ob_seals_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "seals {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(ob_compactions_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "merges {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (increase(ob_compaction_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "merge errors {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WAL file and segments rebuilt at a start",
      "id": 18,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ob_wal_file_index{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "WAL file {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "ob_segments_rebuilt_from_wal_total{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "rebuilt {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Replication and failover",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Replicas",
