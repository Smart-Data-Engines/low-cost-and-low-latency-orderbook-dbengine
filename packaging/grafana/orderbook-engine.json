    },
    {
      "type": "table",
      "title": "Build and role",
      "id": 24,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 52
      },
