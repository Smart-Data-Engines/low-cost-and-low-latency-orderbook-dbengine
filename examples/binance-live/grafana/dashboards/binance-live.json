{
 "title": "Binance live into orderbook-dbengine",
 "uid": "binance-live",
 "description": "examples/binance-live: Binance's depth20 stream written into an orderbook-dbengine node, the market as the node holds it (exporter.py) and the node's own metrics. scripts/check_dashboards.py holds every metric here to the engine's registry and to exporter.py's METRICS.",
 "tags": [
  "orderbook-dbengine",
  "example"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   },
   {
    "name": "symbol",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(market_best_bid, symbol)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Market, read from the engine",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Best bid and ask",
   "id": 2,
   "description": "The top of each symbol's live book in the node (BOOK, depth 1), in the exchange's units, from exporter.py.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_best_bid{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}} bid",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "market_best_ask{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}} ask",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Spread",
   "id": 3,
   "description": "Best ask minus best bid of the live book, in the exchange's units.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_spread{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Quantity at the best prices",
   "id": 4,
   "description": "Quantities at the best bid and ask, in the exchange's units.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_best_bid_qty{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}} bid",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "market_best_ask_qty{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}} ask",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Age of the book in the engine",
   "id": 5,
   "description": "Seconds since the update the live book is as of: how far behind the market the node is, as read from it.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_book_age_seconds{symbol=~\"$symbol\"}",
     "legendFormat": "{{symbol}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Node answering",
   "id": 6,
   "description": "1 when the node answered the exporter's last scrape.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down"
        },
        "1": {
         "text": "up"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_engine_up",
     "legendFormat": "node",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "row",
   "title": "The node",
   "id": 7,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Inserts a second",
   "id": 8,
   "description": "Writes the node took, from ob_total_inserts.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ob_total_inserts{job=\"orderbook\"}[1m]))",
     "legendFormat": "inserts/s",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Insert latency",
   "id": 9,
   "description": "The node's own time for an insert, p50 and p99, from ob_insert_latency_seconds.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(ob_insert_latency_seconds_bucket{job=\"orderbook\"}[5m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(ob_insert_latency_seconds_bucket{job=\"orderbook\"}[5m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Flush tick latency",
   "id": 10,
   "description": "p99 of the background flush tick: the WAL's sync, the drain and the seals.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(ob_flush_latency_seconds_bucket{job=\"orderbook\"}[5m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Pending and unsealed rows",
   "id": 11,
   "description": "Rows waiting for the flush tick, and rows drained into blocks and not yet sealed into segments.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ob_pending_rows{job=\"orderbook\"}",
     "legendFormat": "pending",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "ob_unsealed_rows{job=\"orderbook\"}",
     "legendFormat": "unsealed",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Seals a second",
   "id": 12,
   "description": "Segments written, from ob_seals_total.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ob_seals_total{job=\"orderbook\"}[5m]))",
     "legendFormat": "seals/s",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Bytes on disk",
   "id": 13,
   "description": "Bytes allocated under the node's data directory, from exporter.py --data-dir.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "market_data_dir_bytes",
     "legendFormat": "data directory",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  }
 ]
}
